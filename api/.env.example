PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/before_you_buy?replicaSet=byb-rs
INTERNAL_TOOL_KEY=replace-with-a-local-secret
# true seeds only an empty application database; existing data is preserved.
SEED_ON_START=true
# Generate a private value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
